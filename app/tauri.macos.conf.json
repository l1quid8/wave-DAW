{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Synkopa",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "dragDropEnabled": true,
        "backgroundColor": "#0e1013",
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 27
        }
      }
    ]
  },
  "bundle": {
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "fileAssociations": [
      {
        "ext": [
          "synkopa",
          "wave"
        ],
        "name": "Synkopa Project",
        "description": "Synkopa Project",
        "role": "Editor",
        "rank": "Owner"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "13.4",
      "signingIdentity": "-",
      "entitlements": "Entitlements.plist"
    }
  }
}
